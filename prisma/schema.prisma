generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  PARTNER
  PARTNER_ADMIN
  PARTNER_SELLER
  PARTNER_VIEWER
}

enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  CANCELLED
}

enum CommissionStatus {
  PENDING
  PAID
  CANCELED
}

enum CommissionBatchStatus {
  DRAFT
  PAID
  CANCELED
}

enum PartnerCommissionStatementStatus {
  DRAFT
  SENT
  WAITING_DOCUMENTS
  DOCUMENTS_RECEIVED
  CANCELED
}

enum CommissionStatementDocumentType {
  INVOICE
  BANK_SLIP
}

enum ProposalPlan {
  BASIC
  PROFESSIONAL
  ADVANCED
}

enum ModuleType {
  INFRASTRUCTURE
  ENDPOINT_SECURITY
  CLOUD_SERVICES
  FIREWALL
  WEB_MONITORING
}

enum UnitType {
  ASSET
  ENDPOINT
  USER
  FIREWALL
  URL
  TENANT
}

enum ProposalItemPricingMode {
  AUTO
  MANUAL
}

enum GeneralProposalStatus {
  DRAFT
  INTERNAL_REVIEW
  APPROVED
  SENT
  NEGOTIATION
  WON
  LOST
  CANCELLED
  EXPIRED
}

enum GeneralProposalType {
  NEW_SALE
  RENEWAL
  UPGRADE
  REPLACEMENT
  EXPANSION
  IMPLEMENTATION
  PROJECT
  OTHER
}

enum GeneralPricingMode {
  MARGIN
  MARKUP
  MANUAL
}

enum GeneralServicePricingMode {
  HOURLY
  FIXED
  MANUAL
}

enum AssessmentStatus {
  DRAFT
  SENT
  IN_PROGRESS
  SUBMITTED
  CANCELLED
  EXPIRED
}

enum AssessmentType {
  POC
  IMPLEMENTATION
  COMMERCIAL_SCOPING
  RENEWAL
  OTHER
}

enum GeneralProposalServiceType {
  IMPLEMENTATION
  MIGRATION
  CONFIGURATION
  TRAINING
  CONSULTING
  HEALTH_CHECK
  SUPPORT_HOURS
  PROJECT_MANAGEMENT
  OTHER
}

model User {
  id                                String                               @id @default(cuid())
  name                              String
  email                             String                               @unique
  passwordHash                      String
  role                              UserRole                             @default(PARTNER)
  partnerId                         String?
  companyName                       String?
  phone                             String?
  commissionPercent                 Decimal                              @default(30) @db.Decimal(5, 2)
  isActive                          Boolean                              @default(true)
  partner                           Partner?                             @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  createdProposals                  Proposal[]                           @relation("ProposalCreatedBy")
  deletedProposals                  Proposal[]                           @relation("ProposalDeletedBy")
  createdGeneralProposals           GeneralProposal[]                    @relation("GeneralProposalCreatedBy")
  createdAssessments                Assessment[]                         @relation("AssessmentCreatedBy")
  deletedGeneralProposals           GeneralProposal[]                    @relation("GeneralProposalDeletedBy")
  generalProposalStatusChanges      GeneralProposalStatusHistory[]       @relation("GeneralProposalStatusChangedBy")
  createdInvitations                UserInvitation[]                     @relation("UserInvitationCreatedBy")
  canceledInvitations               UserInvitation[]                     @relation("UserInvitationCanceledBy")
  paidCommissions                   PartnerCommission[]                  @relation("PartnerCommissionPaidBy")
  canceledCommissions               PartnerCommission[]                  @relation("PartnerCommissionCanceledBy")
  clientPaymentConfirmedCommissions PartnerCommission[]                  @relation("PartnerCommissionClientPaymentConfirmedBy")
  releasedCommissions               PartnerCommission[]                  @relation("PartnerCommissionReleasedBy")
  createdCommissionBatches          PartnerCommissionBatch[]             @relation("PartnerCommissionBatchCreatedBy")
  paidCommissionBatches             PartnerCommissionBatch[]             @relation("PartnerCommissionBatchPaidBy")
  canceledCommissionBatches         PartnerCommissionBatch[]             @relation("PartnerCommissionBatchCanceledBy")
  createdCommissionStatements       PartnerCommissionStatement[]         @relation("PartnerCommissionStatementCreatedBy")
  sentCommissionStatements          PartnerCommissionStatement[]         @relation("PartnerCommissionStatementSentBy")
  canceledCommissionStatements      PartnerCommissionStatement[]         @relation("PartnerCommissionStatementCanceledBy")
  documentsReceivedStatements       PartnerCommissionStatement[]         @relation("PartnerCommissionStatementDocumentsReceivedBy")
  uploadedCommissionDocuments       PartnerCommissionStatementDocument[] @relation("PartnerCommissionStatementDocumentUploadedBy")
  deletedAt                         DateTime?
  deletedById                       String?
  deletedBy                         User?                                @relation("UserDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deletedUsers                      User[]                               @relation("UserDeletedBy")
  createdAt                         DateTime                             @default(now())
  updatedAt                         DateTime                             @updatedAt

  @@index([partnerId])
  @@index([deletedAt])
  @@index([deletedById])
}

model Partner {
  id                       String                       @id @default(cuid())
  name                     String
  email                    String?
  companyName              String
  tradeName                String?
  document                 String?
  phone                    String?
  defaultCommissionPercent Decimal                      @default(30) @db.Decimal(5, 2)
  isActive                 Boolean                      @default(true)
  users                    User[]
  invitations              UserInvitation[]
  customers                Customer[]
  proposals                Proposal[]
  commissions              PartnerCommission[]
  commissionBatches        PartnerCommissionBatch[]
  commissionStatements     PartnerCommissionStatement[]
  assessments              Assessment[]
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt

  @@index([companyName])
}

model UserInvitation {
  id           String    @id @default(cuid())
  email        String
  name         String
  role         UserRole
  partnerId    String
  partner      Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  isActive     Boolean   @default(true)
  tokenHash    String    @unique
  expiresAt    DateTime
  acceptedAt   DateTime?
  canceledAt   DateTime?
  createdById  String?
  createdBy    User?     @relation("UserInvitationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  canceledById String?
  canceledBy   User?     @relation("UserInvitationCanceledBy", fields: [canceledById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([email])
  @@index([partnerId])
  @@index([expiresAt])
  @@index([acceptedAt])
  @@index([canceledAt])
}

model Customer {
  id           String  @id @default(cuid())
  companyName  String
  tradeName    String?
  document     String  @unique
  contactName  String
  contactEmail String
  contactPhone String?
  notes        String?

  partnerId String?
  partner   Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  proposals        Proposal[]
  generalProposals GeneralProposal[]
  assessments      Assessment[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([companyName])
  @@index([contactEmail])
  @@index([partnerId])
}

model Proposal {
  id                          String             @id @default(cuid())
  proposalNumber              Int                @unique @default(autoincrement())
  customerId                  String
  partnerId                   String
  createdById                 String?
  title                       String
  status                      ProposalStatus     @default(DRAFT)
  plan                        ProposalPlan
  activeCount                 Int
  unitPrice                   Decimal            @db.Decimal(10, 2)
  setupFee                    Decimal            @default(0) @db.Decimal(10, 2)
  partnerCommissionSetupValue Decimal            @default(0) @db.Decimal(10, 2)
  subtotal                    Decimal            @db.Decimal(10, 2)
  discountPercent             Decimal            @db.Decimal(5, 2)
  discountValue               Decimal            @db.Decimal(10, 2)
  total                       Decimal            @db.Decimal(10, 2)
  partnerCommissionPercent    Decimal            @db.Decimal(5, 2)
  partnerCommissionValue      Decimal            @db.Decimal(10, 2)
  notes                       String?
  scopeDescription            String?
  acceptedByName              String?
  acceptedByEmail             String?
  acceptedAt                  DateTime?
  monthlySubtotal             Decimal            @default(0) @db.Decimal(10, 2)
  setupSubtotal               Decimal            @default(0) @db.Decimal(10, 2)
  discountAmount              Decimal            @default(0) @db.Decimal(10, 2)
  finalMonthlyPrice           Decimal            @default(0) @db.Decimal(10, 2)
  finalSetupPrice             Decimal            @default(0) @db.Decimal(10, 2)
  firstMonthTotal             Decimal            @default(0) @db.Decimal(10, 2)
  partnerCommissionPct        Decimal            @default(0) @db.Decimal(5, 2)
  partnerCommission           Decimal            @default(0) @db.Decimal(10, 2)
  partsecNetRevenue           Decimal            @default(0) @db.Decimal(10, 2)
  validityDays                Int                @default(15)
  internalNotes               String?
  customer                    Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  partner                     Partner            @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  createdBy                   User?              @relation("ProposalCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  deletedAt                   DateTime?
  deletedById                 String?
  deletedBy                   User?              @relation("ProposalDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  items                       ProposalItem[]
  commission                  PartnerCommission?
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt

  @@index([partnerId])
  @@index([createdById])
  @@index([status])
  @@index([deletedAt])
  @@index([deletedById])
}

model PartnerCommission {
  id                              String                      @id @default(cuid())
  proposalId                      String                      @unique
  proposal                        Proposal                    @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  partnerId                       String
  partner                         Partner                     @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  amount                          Decimal                     @db.Decimal(10, 2)
  status                          CommissionStatus            @default(PENDING)
  dueDate                         DateTime?
  paidAt                          DateTime?
  paidById                        String?
  paidBy                          User?                       @relation("PartnerCommissionPaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  paymentReference                String?
  notes                           String?
  clientFirstPaymentConfirmedAt   DateTime?
  clientFirstPaymentConfirmedById String?
  clientFirstPaymentConfirmedBy   User?                       @relation("PartnerCommissionClientPaymentConfirmedBy", fields: [clientFirstPaymentConfirmedById], references: [id], onDelete: SetNull)
  clientPaymentReference          String?
  releasedAt                      DateTime?
  releasedById                    String?
  releasedBy                      User?                       @relation("PartnerCommissionReleasedBy", fields: [releasedById], references: [id], onDelete: SetNull)
  releaseNotes                    String?
  canceledAt                      DateTime?
  canceledById                    String?
  canceledBy                      User?                       @relation("PartnerCommissionCanceledBy", fields: [canceledById], references: [id], onDelete: SetNull)
  batchId                         String?
  batch                           PartnerCommissionBatch?     @relation(fields: [batchId], references: [id], onDelete: SetNull)
  statementId                     String?
  statement                       PartnerCommissionStatement? @relation(fields: [statementId], references: [id], onDelete: SetNull)
  createdAt                       DateTime                    @default(now())
  updatedAt                       DateTime                    @updatedAt

  @@index([partnerId])
  @@index([status])
  @@index([paidAt])
  @@index([createdAt])
  @@index([dueDate])
  @@index([batchId])
  @@index([statementId])
  @@index([releasedAt])
  @@index([clientFirstPaymentConfirmedAt])
}

model PartnerCommissionBatch {
  id               String                @id @default(cuid())
  partnerId        String
  partner          Partner               @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  periodStart      DateTime
  periodEnd        DateTime
  referenceMonth   String?
  status           CommissionBatchStatus @default(DRAFT)
  totalAmount      Decimal               @db.Decimal(10, 2)
  commissionCount  Int
  paidAt           DateTime?
  paidById         String?
  paidBy           User?                 @relation("PartnerCommissionBatchPaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  paymentReference String?
  notes            String?
  canceledAt       DateTime?
  canceledById     String?
  canceledBy       User?                 @relation("PartnerCommissionBatchCanceledBy", fields: [canceledById], references: [id], onDelete: SetNull)
  createdById      String
  createdBy        User                  @relation("PartnerCommissionBatchCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  commissions      PartnerCommission[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([partnerId])
  @@index([status])
  @@index([periodStart, periodEnd])
  @@index([paidAt])
  @@index([createdById])
}

model PartnerCommissionStatement {
  id                    String                               @id @default(cuid())
  partnerId             String
  partner               Partner                              @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  referenceMonth        String
  periodStart           DateTime
  periodEnd             DateTime
  status                PartnerCommissionStatementStatus     @default(DRAFT)
  totalAmount           Decimal                              @db.Decimal(10, 2)
  commissionCount       Int
  sentAt                DateTime?
  sentById              String?
  sentBy                User?                                @relation("PartnerCommissionStatementSentBy", fields: [sentById], references: [id], onDelete: SetNull)
  canceledAt            DateTime?
  canceledById          String?
  canceledBy            User?                                @relation("PartnerCommissionStatementCanceledBy", fields: [canceledById], references: [id], onDelete: SetNull)
  documentsReceivedAt   DateTime?
  documentsReceivedById String?
  documentsReceivedBy   User?                                @relation("PartnerCommissionStatementDocumentsReceivedBy", fields: [documentsReceivedById], references: [id], onDelete: SetNull)
  financeEmailSentAt    DateTime?
  financeEmailSentTo    String?
  documentsNotes        String?
  notes                 String?
  createdById           String
  createdBy             User                                 @relation("PartnerCommissionStatementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  commissions           PartnerCommission[]
  documents             PartnerCommissionStatementDocument[]
  createdAt             DateTime                             @default(now())
  updatedAt             DateTime                             @updatedAt

  @@index([partnerId])
  @@index([status])
  @@index([referenceMonth])
  @@index([periodStart, periodEnd])
  @@index([sentAt])
  @@index([documentsReceivedAt])
  @@index([createdById])
}

model PartnerCommissionStatementDocument {
  id               String                          @id @default(cuid())
  statementId      String
  statement        PartnerCommissionStatement      @relation(fields: [statementId], references: [id], onDelete: Cascade)
  type             CommissionStatementDocumentType
  originalFileName String
  storedFileName   String
  storagePath      String
  mimeType         String
  sizeBytes        Int
  uploadedById     String
  uploadedBy       User                            @relation("PartnerCommissionStatementDocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  uploadedAt       DateTime                        @default(now())
  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt

  @@unique([statementId, type])
  @@index([statementId])
  @@index([type])
  @@index([uploadedById])
}

model ProposalItem {
  id                   String                  @id @default(cuid())
  proposalId           String
  moduleType           ModuleType
  unitType             UnitType
  description          String?
  quantity             Int
  rangeLabel           String
  monthlyPrice         Decimal                 @db.Decimal(10, 2)
  setupPrice           Decimal                 @db.Decimal(10, 2)
  pricingMode          ProposalItemPricingMode @default(AUTO)
  manualMonthlyPrice   Decimal?                @db.Decimal(10, 2)
  manualSetupPrice     Decimal?                @db.Decimal(10, 2)
  pricingJustification String?                 @db.Text
  proposal             Proposal                @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([proposalId])
  @@index([moduleType])
  @@index([pricingMode])
}

model Assessment {
  id               String           @id @default(cuid())
  customerId       String
  partnerId        String?
  createdByUserId  String
  title            String
  type             AssessmentType   @default(POC)
  status           AssessmentStatus @default(DRAFT)
  tokenHash        String?          @unique
  tokenNonce       String?          @unique
  tokenExpiresAt   DateTime?
  firstAccessedAt  DateTime?
  submittedAt      DateTime?
  submittedByName  String?
  submittedByEmail String?
  submittedByPhone String?
  answers          Json?
  internalNotes    String?          @db.Text
  customer         Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  partner          Partner?         @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  createdBy        User             @relation("AssessmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([customerId])
  @@index([partnerId])
  @@index([createdByUserId])
  @@index([status])
  @@index([type])
  @@index([tokenHash])
  @@index([tokenExpiresAt])
  @@index([submittedAt])
  @@index([createdAt])
}

model PriceTable {
  id           String       @id @default(cuid())
  plan         ProposalPlan
  moduleType   ModuleType
  unitType     UnitType
  rangeLabel   String
  minQuantity  Int
  maxQuantity  Int
  monthlyPrice Decimal      @db.Decimal(10, 2)
  setupPrice   Decimal      @db.Decimal(10, 2)
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([plan, moduleType, minQuantity, maxQuantity], name: "PriceTable_plan_moduleType_minQuantity_maxQuantity_key")
  @@index([plan, moduleType, active])
  @@index([unitType])
}

model Vendor {
  id                   String                @id @default(cuid())
  name                 String
  slug                 String                @unique
  logoUrl              String?
  websiteUrl           String?
  category             String?
  shortDescription     String?
  aboutText            String?               @db.Text
  internalNotes        String?               @db.Text
  isActive             Boolean               @default(true)
  generalProposals     GeneralProposal[]     @relation("GeneralProposalPrimaryVendor")
  generalProposalItems GeneralProposalItem[] @relation("GeneralProposalItemVendor")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([name])
  @@index([isActive])
}

model GeneralProposal {
  id                 String                         @id @default(cuid())
  proposalNumber     String                         @unique
  title              String
  customerId         String
  vendorId           String
  createdByUserId    String
  status             GeneralProposalStatus          @default(DRAFT)
  proposalType       GeneralProposalType            @default(NEW_SALE)
  currency           String                         @default("BRL")
  licenseTermMonths  Int?
  validUntil         DateTime?
  paymentTerms       String?                        @db.Text
  executiveSummary   String?                        @db.Text
  projectScope       String?                        @db.Text
  commercialNotes    String?                        @db.Text
  internalNotes      String?                        @db.Text
  subtotalProducts   Decimal                        @default(0) @db.Decimal(12, 2)
  subtotalServices   Decimal                        @default(0) @db.Decimal(12, 2)
  totalCost          Decimal                        @default(0) @db.Decimal(12, 2)
  totalSalePrice     Decimal                        @default(0) @db.Decimal(12, 2)
  totalDiscount      Decimal                        @default(0) @db.Decimal(12, 2)
  finalPrice         Decimal                        @default(0) @db.Decimal(12, 2)
  grossProfit        Decimal                        @default(0) @db.Decimal(12, 2)
  grossMarginPercent Decimal                        @default(0) @db.Decimal(10, 4)
  markupPercent      Decimal                        @default(0) @db.Decimal(10, 4)
  sentAt             DateTime?
  approvedAt         DateTime?
  closedAt           DateTime?
  deletedAt          DateTime?
  deletedById        String?
  customer           Customer                       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vendor             Vendor                         @relation("GeneralProposalPrimaryVendor", fields: [vendorId], references: [id], onDelete: Restrict)
  createdBy          User                           @relation("GeneralProposalCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  deletedBy          User?                          @relation("GeneralProposalDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  items              GeneralProposalItem[]
  services           GeneralProposalService[]
  statusHistory      GeneralProposalStatusHistory[]
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt

  @@index([customerId])
  @@index([vendorId])
  @@index([createdByUserId])
  @@index([status])
  @@index([proposalType])
  @@index([deletedAt])
  @@index([deletedById])
  @@index([createdAt])
}

model GeneralProposalStatusHistory {
  id              String                 @id @default(cuid())
  proposalId      String
  fromStatus      GeneralProposalStatus?
  toStatus        GeneralProposalStatus
  changedByUserId String
  notes           String?                @db.Text
  createdAt       DateTime               @default(now())
  proposal        GeneralProposal        @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  changedBy       User                   @relation("GeneralProposalStatusChangedBy", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([proposalId])
  @@index([changedByUserId])
  @@index([toStatus])
  @@index([createdAt])
}

model GeneralProposalItem {
  id                 String             @id @default(cuid())
  proposalId         String
  vendorId           String?
  sku                String?
  productName        String
  description        String?            @db.Text
  category           String?
  quantity           Decimal            @default(1) @db.Decimal(12, 2)
  licenseTermMonths  Int?
  costUnitPrice      Decimal            @default(0) @db.Decimal(12, 2)
  listUnitPrice      Decimal            @default(0) @db.Decimal(12, 2)
  pricingMode        GeneralPricingMode @default(MARGIN)
  marginPercent      Decimal            @default(0) @db.Decimal(10, 4)
  markupPercent      Decimal            @default(0) @db.Decimal(10, 4)
  discountPercent    Decimal            @default(0) @db.Decimal(10, 4)
  saleUnitPrice      Decimal            @default(0) @db.Decimal(12, 2)
  totalCost          Decimal            @default(0) @db.Decimal(12, 2)
  totalSalePrice     Decimal            @default(0) @db.Decimal(12, 2)
  totalDiscount      Decimal            @default(0) @db.Decimal(12, 2)
  finalItemPrice     Decimal            @default(0) @db.Decimal(12, 2)
  grossProfit        Decimal            @default(0) @db.Decimal(12, 2)
  grossMarginPercent Decimal            @default(0) @db.Decimal(10, 4)
  isVisibleToClient  Boolean            @default(true)
  internalNotes      String?            @db.Text
  sortOrder          Int                @default(0)
  proposal           GeneralProposal    @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  vendor             Vendor?            @relation("GeneralProposalItemVendor", fields: [vendorId], references: [id], onDelete: Restrict)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([proposalId])
  @@index([vendorId])
  @@index([sku])
  @@index([productName])
  @@index([sortOrder])
}

model GeneralProposalService {
  id                 String                     @id @default(cuid())
  proposalId         String
  serviceName        String
  description        String?                    @db.Text
  serviceType        GeneralProposalServiceType @default(OTHER)
  pricingMode        GeneralServicePricingMode  @default(FIXED)
  estimatedHours     Decimal                    @default(0) @db.Decimal(12, 2)
  internalHourlyCost Decimal                    @default(0) @db.Decimal(12, 2)
  saleHourlyRate     Decimal                    @default(0) @db.Decimal(12, 2)
  fixedCost          Decimal                    @default(0) @db.Decimal(12, 2)
  fixedSalePrice     Decimal                    @default(0) @db.Decimal(12, 2)
  totalCost          Decimal                    @default(0) @db.Decimal(12, 2)
  totalSalePrice     Decimal                    @default(0) @db.Decimal(12, 2)
  grossProfit        Decimal                    @default(0) @db.Decimal(12, 2)
  grossMarginPercent Decimal                    @default(0) @db.Decimal(10, 4)
  isVisibleToClient  Boolean                    @default(true)
  internalNotes      String?                    @db.Text
  sortOrder          Int                        @default(0)
  proposal           GeneralProposal            @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@index([proposalId])
  @@index([serviceType])
  @@index([sortOrder])
}
