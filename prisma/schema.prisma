generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  PARTNER
}

enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  CANCELLED
}

enum ProposalPlan {
  ESSENTIAL
  PROFESSIONAL
  ENTERPRISE
}

model User {
  id                String     @id @default(cuid())
  name              String
  email             String     @unique
  passwordHash      String
  role              UserRole   @default(PARTNER)
  companyName       String?
  phone             String?
  commissionPercent Decimal    @default(30) @db.Decimal(5, 2)
  isActive          Boolean    @default(true)
  customers         Customer[]
  proposals         Proposal[] @relation("PartnerProposals")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model Customer {
  id           String  @id @default(cuid())
  companyName  String
  tradeName    String?
  document     String  @unique
  contactName  String
  contactEmail String
  contactPhone String?
  notes        String?

  partnerId String?
  partner   User?   @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  proposals Proposal[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([companyName])
  @@index([contactEmail])
  @@index([partnerId])
}

model Proposal {
  id                          String         @id @default(cuid())
  proposalNumber              Int            @unique @default(autoincrement())
  customerId                  String
  partnerId                   String
  title                       String
  status                      ProposalStatus @default(DRAFT)
  plan                        ProposalPlan
  activeCount                 Int
  unitPrice                   Decimal        @db.Decimal(10, 2)
  setupFee                    Decimal        @default(0) @db.Decimal(10, 2)
  partnerCommissionSetupValue Decimal        @default(0) @db.Decimal(10, 2)
  subtotal                    Decimal        @db.Decimal(10, 2)
  discountPercent             Decimal        @db.Decimal(5, 2)
  discountValue               Decimal        @db.Decimal(10, 2)
  total                       Decimal        @db.Decimal(10, 2)
  partnerCommissionPercent    Decimal        @db.Decimal(5, 2)
  partnerCommissionValue      Decimal        @db.Decimal(10, 2)
  notes                       String?
  scopeDescription            String?
  acceptedByName              String?
  acceptedByEmail             String?
  acceptedAt                  DateTime?
  customer                    Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  partner                     User           @relation("PartnerProposals", fields: [partnerId], references: [id], onDelete: Restrict)
  createdAt                   DateTime       @default(now())
  updatedAt                   DateTime       @updatedAt
}
